# Supabase — copia este archivo a .env.local y rellena con tus valores reales.
# Nunca versiones .env.local ni subas valores reales a Git.

# URL del proyecto (Cloud) o http://127.0.0.1:54321 (local)
VITE_SUPABASE_URL=

# anon key: nunca usar la service_role key en el cliente
VITE_SUPABASE_ANON_KEY=

# TMDB — API key de cliente (v4 o v3 read-only)
VITE_TMDB_API_KEY=
